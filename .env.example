# Enquiry form delivery (src/app/api/enquiry/route.ts). Set ONE of these.

# Option A: send by email through Resend (https://resend.com). The sending domain must be verified there.
RESEND_API_KEY=
ENQUIRY_FROM="Safara Website <website@safaraafrica.com>"
ENQUIRY_TO=info@safaraafrica.com

# Option B: forward the enquiry as JSON to a webhook (HubSpot workflow, Zapier, Make, Slack…)
ENQUIRY_WEBHOOK_URL=

# Spam protection with Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile). Leave empty to rely on the honeypot only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 measurement ID (G-XXXXXXX). Leave empty to load no analytics.
NEXT_PUBLIC_GA_ID=
